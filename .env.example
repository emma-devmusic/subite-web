NEXT_PUBLIC_APP_BASE_URL=https://www.subite.ar
NEXT_PUBLIC_DASHBOARD_BASE_URL=
NEXT_PUBLIC_API_TENANT=1
NEXT_PUBLIC_VERIFY=
NEXT_PUBLIC_SESSION=
NEXT_PUBLIC_S3_REGION=us-east-1
NEXT_PUBLIC_S3_PUBLIC_BUCKET=
NEXT_PUBLIC_S3_PRIVATE_BUCKET=
NEXT_PUBLIC_COOKIE_DOMAIN=.subite.ar
NEXT_PUBLIC_SOCKET_URL=

